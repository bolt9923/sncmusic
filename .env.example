# ════════════════════════════════════════════════════════════════
#  TuneBot — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control!
# ════════════════════════════════════════════════════════════════

# ── Telegram API Credentials ─────────────────────────────────────
# Get from https://my.telegram.org/apps
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# ── Bot Token ────────────────────────────────────────────────────
# Get from @BotFather on Telegram
BOT_TOKEN=123456789:AABBccDDeeFFggHHiiJJkkLLmmNNoo

# ── Assistant Sessions ───────────────────────────────────────────
# Pyrogram string sessions for userbot accounts (voice chat assistants)
# Generate with: python3 -c "from pyrogram import Client; Client('a', api_id=..., api_hash='...').run()"
# Multiple sessions separated by commas for multi-assistant support
STRING_SESSIONS=BQA...session1...,BQA...session2...

# ── Database ──────────────────────────────────────────────────────
# MongoDB Atlas URI: https://cloud.mongodb.com/
# Format: mongodb+srv://user:password@cluster.mongodb.net/
MONGO_DB_URI=mongodb+srv://username:password@cluster.mongodb.net/
DATABASE_NAME=TuneBot

# ── Owner & Admins ────────────────────────────────────────────────
# Your Telegram user ID (get from @userinfobot)
OWNER_ID=123456789
# Comma-separated additional sudo user IDs (optional)
SUDO_USERS=987654321,111222333

# ── Logger Group ─────────────────────────────────────────────────
# Group chat ID for bot logs and startup notifications (optional)
# Leave empty to disable
LOGGER_ID=-100123456789

# ── Force Subscribe ───────────────────────────────────────────────
# Channel username (without @) that users must join before using the bot
# Leave empty to disable
FORCE_SUB_CHANNEL=your_channel_username

# ── Spotify (optional) ────────────────────────────────────────────
# Get from https://developer.spotify.com/dashboard/
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ── Genius Lyrics (optional) ──────────────────────────────────────
# Get from https://genius.com/api-clients
GENIUS_API_TOKEN=your_genius_api_token

# ── Bot Appearance ───────────────────────────────────────────────
BOT_NAME=TuneBot
BOT_USERNAME=your_bot_username
SUPPORT_CHAT=your_support_group_username

# ── Playback Limits ───────────────────────────────────────────────
# Maximum track duration in minutes (default: 180 = 3 hours)
DURATION_LIMIT_MIN=180
# Maximum tracks in queue per group (default: 100)
QUEUE_LIMIT=100
# Default volume 1-200 (default: 100)
DEFAULT_VOLUME=100

# ── 24/7 Mode ────────────────────────────────────────────────────
# Set to "True" to enable 24/7 mode in all chats by default
ALWAYS_ON_DEFAULT=False

# ── Anti-Spam ────────────────────────────────────────────────────
# Cooldown in seconds between commands per user (default: 3)
COMMAND_COOLDOWN=3

# ── Proxy (optional) ─────────────────────────────────────────────
# HTTP/SOCKS5 proxy URL (leave empty to disable)
# Example: socks5://user:pass@host:port
PROXIES=
